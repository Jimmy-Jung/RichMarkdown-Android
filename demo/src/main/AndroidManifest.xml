<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- SSE 데모가 사용자가 입력한 https 엔드포인트를 읽는다. 평문 http는 금지한다. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="false"
        android:icon="@android:drawable/sym_def_app_icon"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.RichMarkdownDemo"
        android:usesCleartextTraffic="false">

        <!-- 데모 화면은 전부 exported=true: adb shell am start로 각 화면에 직접 진입해 스크린샷을 찍는다 (string extra renderer=view, boolean extra autoplay=true).
             extra는 화면 옵션만 읽고 권한·데이터 접근이 없다. -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".ShowcaseActivity"
            android:exported="true"
            android:label="@string/title_showcase" />
        <activity
            android:name=".ComposeChatActivity"
            android:exported="true"
            android:label="@string/title_compose_chat" />
        <activity
            android:name=".ViewChatActivity"
            android:exported="true"
            android:label="@string/title_view_chat" />
        <activity
            android:name=".SseStreamingActivity"
            android:exported="true"
            android:label="@string/title_sse"
            android:windowSoftInputMode="adjustResize" />
    </application>
</manifest>
